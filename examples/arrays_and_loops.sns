# Arrays, for-in, break/continue, builtins.

users: Array<String> = ["alice", "bob", "carol", "dave"]

for user in users:
    if user == "carol":
        continue
    if user == "dave":
        break
    print("notifying " + user)

total = 0
for n in range(1, 6):
    total = total + n
print("sum 1..5 =", total)

scores = [1, 2, 3]
push(scores, 4)
scores[0] = 10
print(scores)
